# Public site URL, used for metadata, sitemap.xml and canonical links.
NEXT_PUBLIC_SITE_URL=https://frugelle.vercel.app

# From manage.sanity.io, same values as in the frugelle-studio project's .env
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Only needed locally to run scripts/migrate-to-sanity.mjs once. Create this token at
# manage.sanity.io > your project > API > Tokens, with "Editor" permissions.
SANITY_API_TOKEN=

# MailerLite API credentials for the newsletter signup form.
# Get these from MailerLite > Integrations > API.
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=
